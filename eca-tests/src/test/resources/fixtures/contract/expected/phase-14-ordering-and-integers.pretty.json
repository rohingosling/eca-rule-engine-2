{
  "schemaVersion" : "1.0",
  "modelId" : "phase-14-contract",
  "name" : "Phase 14 contract",
  "description" : "Exercises exact integers, ordering, wildcard, ANY, and omission behavior.",
  "parameters" : [ {
    "id" : "parameter-enum",
    "name" : "Enumeration",
    "description" : "Enumeration ordering contract.",
    "type" : "ENUM",
    "enumValues" : [ "ALPHA", "ZULU" ]
  }, {
    "id" : "parameter-integer",
    "name" : "Integer",
