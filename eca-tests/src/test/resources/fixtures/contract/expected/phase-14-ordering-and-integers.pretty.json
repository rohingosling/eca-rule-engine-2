  } ],
  "actions" : [ {
    "id" : "action-accept",
    "name" : "Accept",
    "description" : "Accept the occurrence."
  } ],
  "rules" : [ {
    "id" : "rule-legacy",
    "name" : "Legacy rule",
    "description" : "Uses the legacy binding representation.",
    "eventId" : "event-contract",
    "conditionSetId" : "condition-set-legacy",
    "actionId" : "action-accept"
  }, {
    "id" : "rule-predefined",
    "name" : "Predefined rule",
    "description" : "Uses reusable condition predicates.",
    "eventId" : "event-contract",
