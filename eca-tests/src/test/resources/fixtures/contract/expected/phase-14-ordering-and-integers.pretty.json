    "id" : "condition-integer-minimum",
    "name" : "Integer minimum",
    "description" : "Uses the signed 64-bit minimum.",
    "parameterId" : "parameter-integer",
    "operator" : "EQUALS",
    "value" : -9223372036854775808
  }, {
    "id" : "condition-integer-range",
    "name" : "Integer range",
    "description" : "Covers the complete signed 64-bit domain.",
    "parameterId" : "parameter-integer",
    "operator" : "BETWEEN_INCLUSIVE",
    "value" : -9223372036854775808,
    "secondValue" : 9223372036854775807
  }, {
    "id" : "condition-string-any",
    "name" : "Any string",
    "description" : "Retains an explicitly selected ANY predicate.",
    "parameterId" : "parameter-string",
    "operator" : "ANY"
  }, {
    "id" : "condition-string-unconfigured",
    "name" : "Unconfigured string",
    "description" : "Retains an omitted predicate.",
    "parameterId" : "parameter-string"
  } ],
  "conditionSets" : [ {
    "id" : "condition-set-empty",
    "name" : "Empty",
    "description" : "Omits every available condition.",
