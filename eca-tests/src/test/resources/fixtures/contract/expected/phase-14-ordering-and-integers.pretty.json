    "type" : "INTEGER"
  }, {
    "id" : "parameter-string",
    "name" : "String",
    "description" : "String contract value.",
    "type" : "STRING"
  } ],
  "payloads" : [ {
    "id" : "payload-contract",
    "name" : "Contract payload",
    "description" : "Permits all contract parameters.",
    "parameterIds" : [ "parameter-enum", "parameter-integer", "parameter-string" ]
  } ],
  "events" : [ {
    "id" : "event-contract",
    "name" : "Contract event",
    "description" : "Carries contract values.",
    "payloadId" : "payload-contract"
  } ],
